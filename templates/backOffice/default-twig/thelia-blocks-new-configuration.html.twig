{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Thelia blocks'|trans({}, 'TheliaBlocks') }}{% endblock %}
{% block body_testid %}thelia-blocks-new{% endblock %}

{% block content %}
    {% if is_granted('VIEW', 'admin.content') %}
        <div id="thelia-blocks-root-new" class="thelia-blocks-ui"></div>
    {% endif %}
{% endblock %}

{% block scripts_extra %}
    <script type="module">
        let CONTAINER = document.getElementById("thelia-blocks-root-new");
        ReactDOM.render(React.createElement(TheliaBlocks.BlocksEditor, {
            apiUrl: window.THELIA_BLOCKS_API_ROOT,
            containerId: "thelia-blocks-root-new",
            groupId: null,
            locales: window.THELIA_BLOCKS_LOCALES,
            urlPrefix: window.THELIA_BLOCKS_URL_PREFIX,
        }, null), CONTAINER);
    </script>
{% endblock %}
