{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Thelia blocks'|trans({}, 'TheliaBlocks') }}{% endblock %}
{% block body_testid %}thelia-blocks-list{% endblock %}

{% block content %}
    {% if is_granted('VIEW', 'admin.content') %}
        <div id="thelia-blocks-root" class="thelia-blocks-ui"></div>
    {% endif %}
{% endblock %}

{% block scripts_extra %}
    <script>
    (function () {
        // The React editor hard-codes the default admin prefix in its links and redirects.
        // When the BackOfficePath module serves the back-office under a custom path, it rewrites
        // every literal admin prefix in this response. "realBase" carries that rewrite; "defaultBase"
        // is rebuilt at runtime so it stays untouched. When they differ, realign the hard-coded URLs.
        var realBase = '/admin';
        var defaultBase = '/' + 'admin';
        if (realBase === defaultBase) {
            return;
        }
        var needle = defaultBase + '/TheliaBlocks';
        var remap = function (url) {
            return (typeof url === 'string' && url.indexOf(needle) === 0)
                ? realBase + url.slice(defaultBase.length)
                : url;
        };
        document.addEventListener('click', function (event) {
            var anchor = event.target && event.target.closest ? event.target.closest('a[href]') : null;
            if (!anchor) {
                return;
            }
            var fixed = remap(anchor.getAttribute('href'));
            if (fixed !== anchor.getAttribute('href')) {
                anchor.setAttribute('href', fixed);
            }
        }, true);
        // location.assign/replace cannot be overridden, so realign programmatic redirects
        // (issued after save/create) through the Navigation API where it is available.
        if (window.navigation && typeof window.navigation.addEventListener === 'function') {
            window.navigation.addEventListener('navigate', function (event) {
                if (!event.cancelable) {
                    return;
                }
                var target;
                try {
                    target = new URL(event.destination.url);
                } catch (error) {
                    return;
                }
                if (target.origin !== window.location.origin) {
                    return;
                }
                var path = target.pathname + target.search + target.hash;
                var fixed = remap(path);
                if (fixed !== path) {
                    event.preventDefault();
                    window.location.replace(fixed);
                }
            });
        }
    })();
    </script>
    {# type="module" defers execution until after the synchronous React/ReactDOM scripts
       injected by the main.footer-js hook, which the layout renders after this block. #}
    <script type="module">
        let CONTAINER = document.getElementById('thelia-blocks-root');
        ReactDOM.render(React.createElement(TheliaBlocks.BlocksList, {
            containerId: "thelia-blocks-root",
            apiUrl: window.THELIA_BLOCKS_API_ROOT,
            isEditing: true,
            locales: window.THELIA_BLOCKS_LOCALES,
            urlPrefix: window.THELIA_BLOCKS_URL_PREFIX,
        }, null), CONTAINER);
    </script>
{% endblock %}
